#!/usr/bin/env bash
# Optional interactive version bump before push.
# Install: git config core.hooksPath scripts/git-hooks
# Skip: SKIP_VERSION_BUMP=1 git push
# Non-interactive environments (no /dev/tty): hook does nothing.

set -euo pipefail

if [[ -n "${SKIP_VERSION_BUMP:-}" ]]; then
	exit 0
fi
if [[ -n "${CI:-}" || -n "${GITHUB_ACTIONS:-}" ]]; then
	exit 0
fi
if [[ ! -c /dev/tty ]]; then
	exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
exec "$ROOT/scripts/bump-version.sh" --hook
